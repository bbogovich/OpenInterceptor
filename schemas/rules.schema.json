{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenInterceptor rules file (rules/*.yaml, campaign/*.yaml)",
  "type": "object", "additionalProperties": false, "properties": {
    "factions": {"description": "factions by id", "type": "object", "additionalProperties": {"type": "object", "patternProperties": {"^[a-z_]+[+-]$": {"type": "array"}}, "additionalProperties": false, "properties": {
          "name": {"description": "display name", "type": "string"},
          "color": {"description": "radar and HUD colour, 0..1", "type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3},
          "hostile": {"description": "faction ids this faction fights", "type": "array", "items": {"type": "string", "pattern": "^[a-z0-9_.-]+$"}},
          "inherit": {"type": "string", "description": "copy another definition of this kind first, or original:<file>/<section>"},
          "delete": {"type": "boolean"},
          "variants": {"type": "object", "description": "per difficulty level: keys that differ"}
        }}},
    "beams": {"description": "beam weapons by id", "type": "object", "additionalProperties": {"type": "object", "patternProperties": {"^[a-z_]+[+-]$": {"type": "array"}}, "additionalProperties": false, "properties": {
          "name": {"description": "display name", "type": "string"},
          "damage": {"description": "damage per hit", "anyOf": [{"type": "number"}, {"type": "object", "properties": {"per_level": {"type": "array", "items": {"type": "number"}}}, "required": ["per_level"], "additionalProperties": false}]},
          "energy_cost": {"description": "energy per shot", "anyOf": [{"type": "number"}, {"type": "object", "properties": {"per_level": {"type": "array", "items": {"type": "number"}}}, "required": ["per_level"], "additionalProperties": false}]},
          "rate_of_fire": {"description": "shots per second per mount", "anyOf": [{"type": "number"}, {"type": "object", "properties": {"per_level": {"type": "array", "items": {"type": "number"}}}, "required": ["per_level"], "additionalProperties": false}]},
          "speed": {"description": "bolt speed, m/s", "anyOf": [{"type": "number"}, {"type": "object", "properties": {"per_level": {"type": "array", "items": {"type": "number"}}}, "required": ["per_level"], "additionalProperties": false}]},
          "range": {"description": "reach (2.4km, 2400m; a plain number is metres)", "anyOf": [{"anyOf": [{"type": "number"}, {"type": "string", "pattern": "^-?[0-9.]+(m|km)?$"}]}, {"type": "object", "properties": {"per_level": {"type": "array", "items": {"anyOf": [{"type": "number"}, {"type": "string", "pattern": "^-?[0-9.]+(m|km)?$"}]}}}, "required": ["per_level"], "additionalProperties": false}]},
          "color": {"description": "bolt colour", "type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3},
          "sound": {"description": "firing sound", "type": "string"},
          "inherit": {"type": "string", "description": "copy another definition of this kind first, or original:<file>/<section>"},
          "delete": {"type": "boolean"},
          "variants": {"type": "object", "description": "per difficulty level: keys that differ"}
        }}},
    "missiles": {"description": "missiles by id", "type": "object", "additionalProperties": {"type": "object", "patternProperties": {"^[a-z_]+[+-]$": {"type": "array"}}, "additionalProperties": false, "properties": {
          "name": {"description": "display name", "type": "string"},
          "speed": {"description": "top speed, m/s", "anyOf": [{"type": "number"}, {"type": "object", "properties": {"per_level": {"type": "array", "items": {"type": "number"}}}, "required": ["per_level"], "additionalProperties": false}]},
          "duration": {"description": "flight time before self-destruct", "anyOf": [{"anyOf": [{"type": "number"}, {"type": "string", "pattern": "^-?[0-9.]+(s|min|h)?$"}]}, {"type": "object", "properties": {"per_level": {"type": "array", "items": {"anyOf": [{"type": "number"}, {"type": "string", "pattern": "^-?[0-9.]+(s|min|h)?$"}]}}}, "required": ["per_level"], "additionalProperties": false}]},
          "impact_damage": {"description": "damage on a direct hit", "anyOf": [{"type": "number"}, {"type": "object", "properties": {"per_level": {"type": "array", "items": {"type": "number"}}}, "required": ["per_level"], "additionalProperties": false}]},
          "proximity_damage": {"description": "damage from the proximity fuse", "anyOf": [{"type": "number"}, {"type": "object", "properties": {"per_level": {"type": "array", "items": {"type": "number"}}}, "required": ["per_level"], "additionalProperties": false}]},
          "proximity_radius": {"description": "proximity fuse radius", "anyOf": [{"anyOf": [{"type": "number"}, {"type": "string", "pattern": "^-?[0-9.]+(m|km)?$"}]}, {"type": "object", "properties": {"per_level": {"type": "array", "items": {"anyOf": [{"type": "number"}, {"type": "string", "pattern": "^-?[0-9.]+(m|km)?$"}]}}}, "required": ["per_level"], "additionalProperties": false}]},
          "turn_rate": {"description": "degrees per second while homing", "anyOf": [{"type": "number"}, {"type": "object", "properties": {"per_level": {"type": "array", "items": {"type": "number"}}}, "required": ["per_level"], "additionalProperties": false}]},
          "lock_time": {"description": "seconds in the lock cone to lock on", "anyOf": [{"anyOf": [{"type": "number"}, {"type": "string", "pattern": "^-?[0-9.]+(s|min|h)?$"}]}, {"type": "object", "properties": {"per_level": {"type": "array", "items": {"anyOf": [{"type": "number"}, {"type": "string", "pattern": "^-?[0-9.]+(s|min|h)?$"}]}}}, "required": ["per_level"], "additionalProperties": false}]},
          "color": {"description": "trail colour", "type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3},
          "sound": {"description": "launch sound", "type": "string"},
          "explosion": {"description": "effect id of its detonation", "type": "string", "pattern": "^[a-z0-9_.-]+$"},
          "guidance": {"description": "how it steers (default homing)", "enum": ["homing", "dumbfire", "sidestep", "parallax", "cloaked_wait", "cluster", "doppelganger"]},
          "damage": {"description": "how the warhead's damage lands", "enum": ["normal", "bypass_shields", "enveloping"]},
          "decoys": {"description": "parallax: decoys released at launch (default 2)", "anyOf": [{"type": "number"}, {"type": "object", "properties": {"per_level": {"type": "array", "items": {"type": "number"}}}, "required": ["per_level"], "additionalProperties": false}]},
          "cluster": {"description": "cluster: what it splits into", "type": "object", "additionalProperties": false, "properties": {
              "missile": {"description": "submunition missile id", "type": "string", "pattern": "^[a-z0-9_.-]+$"},
              "count": {"description": "how many", "anyOf": [{"type": "number"}, {"type": "object", "properties": {"per_level": {"type": "array", "items": {"type": "number"}}}, "required": ["per_level"], "additionalProperties": false}]},
              "at": {"description": "split this close to the target", "anyOf": [{"anyOf": [{"type": "number"}, {"type": "string", "pattern": "^-?[0-9.]+(m|km)?$"}]}, {"type": "object", "properties": {"per_level": {"type": "array", "items": {"anyOf": [{"type": "number"}, {"type": "string", "pattern": "^-?[0-9.]+(m|km)?$"}]}}}, "required": ["per_level"], "additionalProperties": false}]}
            }},
          "trigger_range": {"description": "cloaked_wait: wakes when a hostile comes this close", "anyOf": [{"anyOf": [{"type": "number"}, {"type": "string", "pattern": "^-?[0-9.]+(m|km)?$"}]}, {"type": "object", "properties": {"per_level": {"type": "array", "items": {"anyOf": [{"type": "number"}, {"type": "string", "pattern": "^-?[0-9.]+(m|km)?$"}]}}}, "required": ["per_level"], "additionalProperties": false}]},
          "inherit": {"type": "string", "description": "copy another definition of this kind first, or original:<file>/<section>"},
          "delete": {"type": "boolean"},
          "variants": {"type": "object", "description": "per difficulty level: keys that differ"}
        }}},
    "ships": {"description": "craft by id", "type": "object", "additionalProperties": {"type": "object", "patternProperties": {"^[a-z_]+[+-]$": {"type": "array"}}, "additionalProperties": false, "properties": {
          "name": {"description": "display name", "type": "string"},
          "description": {"description": "one line for the viewer and encyclopaedia", "type": "string"},
          "kind": {"description": "what sort of object it is", "enum": ["fighter", "freighter", "capital", "drone", "station", "probe", "mine", "debris"]},
          "faction": {"description": "owning faction id", "type": "string", "pattern": "^[a-z0-9_.-]+$"},
          "model_set": {"description": "the look: a model set id (instead of model and debris)", "type": "string", "pattern": "^[a-z0-9_.-]+$"},
          "model": {"description": "model reference: models/x.obj or original:MESH (shorthand for a model set)", "type": "string"},
