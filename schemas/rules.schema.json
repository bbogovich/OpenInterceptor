          "shield_recharge": {"description": "shield points per second per facing at full charge", "anyOf": [{"type": "number"}, {"type": "object", "properties": {"per_level": {"type": "array", "items": {"type": "number"}}}, "required": ["per_level"], "additionalProperties": false}]},
          "max_speed": {"description": "top speed, m/s", "anyOf": [{"type": "number"}, {"type": "object", "properties": {"per_level": {"type": "array", "items": {"type": "number"}}}, "required": ["per_level"], "additionalProperties": false}]},
          "acceleration": {"description": "m/s²", "anyOf": [{"type": "number"}, {"type": "object", "properties": {"per_level": {"type": "array", "items": {"type": "number"}}}, "required": ["per_level"], "additionalProperties": false}]},
          "roll_rate": {"description": "degrees per second", "anyOf": [{"type": "number"}, {"type": "object", "properties": {"per_level": {"type": "array", "items": {"type": "number"}}}, "required": ["per_level"], "additionalProperties": false}]},
          "pitch_rate": {"description": "degrees per second at rest", "anyOf": [{"type": "number"}, {"type": "object", "properties": {"per_level": {"type": "array", "items": {"type": "number"}}}, "required": ["per_level"], "additionalProperties": false}]},
          "yaw_rate": {"description": "degrees per second at rest", "anyOf": [{"type": "number"}, {"type": "object", "properties": {"per_level": {"type": "array", "items": {"type": "number"}}}, "required": ["per_level"], "additionalProperties": false}]},
          "angular_damp": {"description": "0 tight … 10 loose", "anyOf": [{"type": "number"}, {"type": "object", "properties": {"per_level": {"type": "array", "items": {"type": "number"}}}, "required": ["per_level"], "additionalProperties": false}]},
          "lock_speed": {"description": "speed at which pitch and yaw fall to zero, m/s", "anyOf": [{"type": "number"}, {"type": "object", "properties": {"per_level": {"type": "array", "items": {"type": "number"}}}, "required": ["per_level"], "additionalProperties": false}]},
          "vct": {"description": "fitted with vector control thrusters", "type": "boolean"},
          "energy": {"description": "beam capacitor", "anyOf": [{"type": "number"}, {"type": "object", "properties": {"per_level": {"type": "array", "items": {"type": "number"}}}, "required": ["per_level"], "additionalProperties": false}]},
          "energy_recharge": {"description": "capacitor recharge per second at full beam charge", "anyOf": [{"type": "number"}, {"type": "object", "properties": {"per_level": {"type": "array", "items": {"type": "number"}}}, "required": ["per_level"], "additionalProperties": false}]},
          "beams": {"description": "one beam id per mount", "type": "array", "items": {"type": "string", "pattern": "^[a-z0-9_.-]+$"}},
          "missiles": {"description": "missile id: count, one rack each", "type": "object", "additionalProperties": {"anyOf": [{"type": "number"}, {"type": "object", "properties": {"per_level": {"type": "array", "items": {"type": "number"}}}, "required": ["per_level"], "additionalProperties": false}]}},
          "systems": {"description": "fitted systems (replaces the default list)", "type": "array", "items": {"type": "string", "pattern": "^[a-z0-9_.-]+$"}},
          "repair_rate": {"description": "hit points per second the crew repairs", "anyOf": [{"type": "number"}, {"type": "object", "properties": {"per_level": {"type": "array", "items": {"type": "number"}}}, "required": ["per_level"], "additionalProperties": false}]},
          "capturable": {"description": "can be captured with a tractor beam when disabled", "type": "boolean"},
          "behaviour": {"description": "AI behaviour id", "type": "string", "pattern": "^[a-z0-9_.-]+$"},
          "turret_arc": {"description": "beams can aim this far off the nose (turrets)", "anyOf": [{"anyOf": [{"type": "number"}, {"type": "string", "pattern": "^-?[0-9.]+(deg)?$"}]}, {"type": "object", "properties": {"per_level": {"type": "array", "items": {"anyOf": [{"type": "number"}, {"type": "string", "pattern": "^-?[0-9.]+(deg)?$"}]}}}, "required": ["per_level"], "additionalProperties": false}]},
          "debris": {"description": "wreckage models", "type": "array", "items": {"type": "string"}},
          "engine_color": {"description": "engine glow colour", "type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3},
          "modules": {"description": "stations: modules mounted at the model's attachment points", "type": "array", "items": {"type": "object", "additionalProperties": false, "properties": {
                "slot": {"description": "attachment point: its index (original meshes) or slot name (OBJ slot_<name>)", "type": "string"},
                "class": {"description": "the module's object id", "type": "string", "pattern": "^[a-z0-9_.-]+$"}
              }}},
          "shield_generator": {"description": "modules: while one survives, its station's shields work", "type": "boolean"},
          "inherit": {"type": "string", "description": "copy another definition of this kind first, or original:<file>/<section>"},
          "delete": {"type": "boolean"},
          "variants": {"type": "object", "description": "per difficulty level: keys that differ"}
        }}},
